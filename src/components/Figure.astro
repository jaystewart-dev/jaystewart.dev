---
import { Image } from 'astro:assets';

/**
 * A screenshot with a caption.
 *
 * Screenshots are supplied separately from the writing, so this component has
 * to handle their absence without leaving a hole in the page. When `src` is
 * omitted it renders a labelled placeholder at the correct aspect ratio: the
 * layout is final, nothing shifts when the real image lands, and the gap is
 * visible to whoever is meant to fill it rather than silently missing.
 */

interface Props {
  /** Imported image. Omit to render the placeholder. */
  src?: ImageMetadata;
  /** Required whenever `src` is set — describe what the image shows. */
  alt?: string;
  caption: string;
  /** Placeholder aspect ratio, and a hint for what to capture. */
  ratio?: 'wide' | 'phone' | 'square';
  width?: number;
}

const { src, alt, caption, ratio = 'wide', width = 1400 } = Astro.props;

if (src && !alt) {
  throw new Error(`Figure "${caption}" has an image but no alt text.`);
}

const ratios = {
  wide: 'aspect-[16/10]',
  phone: 'aspect-[9/17] max-w-[16rem] mx-auto',
  square: 'aspect-square max-w-[28rem] mx-auto',
} as const;
---

<figure class="not-prose my-8">
  {
    src ? (
      <Image
        src={src}
        alt={alt!}
        width={width}
        densities={[1, 2]}
        loading="lazy"
        decoding="async"
        class="rounded-lg border border-line bg-surface"
      />
    ) : (
      <div
        class:list={[
          'flex items-center justify-center rounded-lg border border-dashed border-line-strong bg-band',
          ratios[ratio],
        ]}
      >
        <p class="px-6 text-center font-mono text-xs text-muted">Screenshot pending</p>
      </div>
    )
  }

  <figcaption class="mt-3 text-sm text-muted">{caption}</figcaption>
</figure>
