---
/**
 * Light/dark toggle.
 *
 * Three states matter, not two: system, explicitly light, explicitly dark. The
 * button cycles through explicit light and dark and stores the choice; a reader
 * who has never touched it stays on their system preference, which the
 * stylesheet handles without any JavaScript at all.
 *
 * This is the only interactive JavaScript on the site — roughly 500 bytes,
 * inline, no framework.
 */
---

<button
  type="button"
  id="theme-toggle"
  class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-line text-muted transition-colors hover:border-line-strong hover:text-ink"
  aria-label="Switch to dark theme"
  aria-live="polite"
>
  {
    /* Both icons ship; CSS shows the one matching the active theme, so the
      correct icon is right on the first frame with no scripting. */
  }
  <svg
    class="icon-sun h-4 w-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
    ></path>
  </svg>
  <svg
    class="icon-moon h-4 w-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  /* Default (light): offer the moon, hide the sun. */
  .icon-sun {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .icon-sun {
      display: block;
    }
    :root:not([data-theme='light']) .icon-moon {
      display: none;
    }
  }

  :root[data-theme='dark'] .icon-sun {
    display: block;
  }
  :root[data-theme='dark'] .icon-moon {
    display: none;
  }
  :root[data-theme='light'] .icon-sun {
    display: none;
  }
  :root[data-theme='light'] .icon-moon {
    display: block;
  }
</style>

<script is:inline>
  (() => {
    const button = document.getElementById('theme-toggle');
    if (!button) return;

    const root = document.documentElement;
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');

    const isDark = () =>
      root.dataset.theme ? root.dataset.theme === 'dark' : prefersDark.matches;

    // The label must describe the action, not the state — a screen-reader user
    // needs to know what pressing it will do.
    const syncLabel = () => {
      button.setAttribute(
        'aria-label',
        isDark() ? 'Switch to light theme' : 'Switch to dark theme',
      );
    };

    button.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* Storage unavailable; the choice applies for this page view only. */
      }
      syncLabel();
    });

    // Follow the system if the reader has not chosen explicitly.
    prefersDark.addEventListener('change', syncLabel);
    syncLabel();
  })();
</script>
