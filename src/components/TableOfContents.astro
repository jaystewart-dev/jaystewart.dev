---
/**
 * A page's `##` sections, rendered twice for two different jobs rather than
 * once and repositioned with CSS: below `lg` it is a closed-by-default
 * `<details>` a reader opens on purpose (screen space is scarce there), and
 * from `lg` up it is an always-visible sticky rail (screen space isn't). A
 * `<details>` cannot be forced open only above a breakpoint with CSS alone,
 * so this is two render paths, not one repositioned element — call it once
 * per variant, each gated by the caller on the same `sections.length > 2`
 * check.
 *
 * Both variants mark the section currently under the reader as
 * `aria-current="location"`, driven by the script at the bottom of this file.
 * Every page with a contents list gets it, because every page with a contents
 * list renders this component.
 */
interface Props {
  sections: { slug: string; text: string }[];
  variant: 'mobile' | 'desktop';
}

const { sections, variant } = Astro.props;
---

{
  variant === 'mobile' ? (
    <details class="group mb-14 rounded-md border border-line lg:hidden">
      <summary class="eyebrow flex cursor-pointer list-none items-center justify-between px-4 py-3">
        Contents
        <span
          aria-hidden="true"
          class="transition-transform duration-200 group-open:rotate-180"
        >
          ↓
        </span>
      </summary>
      <ol class="space-y-1.5 border-t border-line px-4 py-3 text-sm">
        {sections.map((section, index) => (
          <li class="toc-item flex gap-3">
            <span class="toc-index font-mono text-xs text-muted tabular-nums transition-colors">
              {String(index + 1).padStart(2, '0')}
            </span>
            <a href={`#${section.slug}`} class="link-underline transition-colors" data-toc-link>
              {section.text}
            </a>
          </li>
        ))}
      </ol>
    </details>
  ) : (
    <nav
      aria-labelledby="toc-heading-desktop"
      class="hidden lg:sticky lg:top-24 lg:block lg:self-start"
    >
      <h2 id="toc-heading-desktop" class="eyebrow">
        Contents
      </h2>
      <ol class="mt-3 space-y-1.5 text-sm">
        {sections.map((section, index) => (
          <li class="toc-item flex gap-3">
            <span class="toc-index font-mono text-xs text-muted tabular-nums transition-colors">
              {String(index + 1).padStart(2, '0')}
            </span>
            <a href={`#${section.slug}`} class="link-underline transition-colors" data-toc-link>
              {section.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  /* The whole row moves, number included — the number is what a reader counts
     position by, so leaving it grey would highlight half the entry. */
  [data-toc-link][aria-current] {
    color: var(--c-accent);
    text-decoration-color: var(--c-accent);
  }

  .toc-item:has([data-toc-link][aria-current]) .toc-index {
    color: var(--c-accent);
  }
</style>

<script is:inline>
  (() => {
    // Both variants render on every page that has a contents list, so this
    // script ships twice and must wire itself up once.
    if (window.__tocScrollSpy) return;
    window.__tocScrollSpy = true;

    const start = () => {
      const links = [...document.querySelectorAll('[data-toc-link]')];
      if (links.length === 0) return;

      // Headings in document order, taken from the links rather than from the
      // prose: a link whose target went missing is simply skipped.
      const headings = [...new Set(links.map((link) => link.hash.slice(1)))]
        .map((id) => document.getElementById(id))
        .filter(Boolean);
      if (headings.length === 0) return;

      let currentId = null;

      const paint = (id) => {
        if (id === currentId) return;
        currentId = id;
        for (const link of links) {
          if (link.hash.slice(1) === id) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        }
      };

      // The line a section becomes current at is the line an anchor jump lands a
      // heading on, so the highlight always agrees with what clicking the link
      // would have done. One source of truth for both: `scroll-padding-top`.
      const line = () =>
        parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 80;

      const update = () => {
        const y = line() + 1;

        // Nothing is current above the first heading — the reader is still in
        // the page header, not in a section.
        let active = null;
        for (const heading of headings) {
          if (heading.getBoundingClientRect().top > y) break;
          active = heading.id;
        }

        // A short last section may never reach the line, so it would otherwise
        // never light up. Once the page cannot scroll further, it is what is on
        // screen.
        const atEnd =
          window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;

        paint(atEnd ? headings[headings.length - 1].id : active);
      };

      let queued = false;
      const schedule = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          update();
        });
      };

      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule, { passive: true });
      update();
    };

    // The mobile list renders above the prose, so at this point the headings it
    // links to are not parsed yet and looking them up would find nothing.
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', start, { once: true });
    } else {
      start();
    }
  })();
</script>
