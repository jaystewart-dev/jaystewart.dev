---
import type { CollectionEntry } from 'astro:content';
import { resolve } from '../lib/metrics.ts';

interface Props {
  entry: CollectionEntry<'caseStudies'>;
}

const { entry } = Astro.props;
const { data } = entry;
const href = `/work/${entry.id}/`;

// Two figures on a card. More turns a summary into a dashboard.
const highlights = data.metrics.slice(0, 2).map(resolve);
---

<article class="card group flex flex-col p-6 transition-colors hover:border-line-strong sm:p-8">
  <div class="flex flex-wrap items-center gap-2.5">
    <span class="font-mono text-xs text-accent">{data.status}</span>
    <span class="text-muted" aria-hidden="true">·</span>
    <span class="font-mono text-xs text-muted">{data.period}</span>
  </div>

  <h2 class="mt-3 text-2xl">
    {
      /* The whole card is the target, without nesting interactive elements:
        one real link, stretched over the card with a pseudo-element. */
    }
    <a href={href} class="after:absolute after:inset-0 after:content-['']">
      {data.title}
    </a>
  </h2>

  <p class="mt-3 grow text-muted">{data.summary}</p>

  {
    highlights.length > 0 && (
      <dl class="mt-6 flex gap-8">
        {highlights.map(({ label, value }) => (
          <div class="flex flex-col-reverse">
            <dt class="text-xs text-muted">{label}</dt>
            <dd class="font-mono text-lg font-medium tabular-nums">{value}</dd>
          </div>
        ))}
      </dl>
    )
  }

  <ul class="mt-6 flex flex-wrap gap-2" aria-label="Technologies">
    {data.stack.slice(0, 4).map((item) => <li class="tag">{item}</li>)}
    {data.stack.length > 4 && <li class="tag">+{data.stack.length - 4}</li>}
  </ul>

  <p class="mt-6 text-sm font-medium text-accent">
    Read the case study
    <span
      class="inline-block transition-transform group-hover:translate-x-0.5"
      aria-hidden="true"
    >
      →
    </span>
  </p>
</article>

<style>
  article {
    position: relative;
  }
</style>
