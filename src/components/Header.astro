---
import ThemeToggle from './ThemeToggle.astro';
import { nav, site } from '../data/site.ts';

const path = Astro.url.pathname;

/**
 * A nav item is current when the page is it, or lives under it — and when two
 * items both match, only the more specific one is. The agents entry points at
 * a page under `/work/`, and a nav with two current items tells a screen-reader
 * user the wrong thing about where they are.
 */
const matches = (href: string) => path === href || (href !== '/' && path.startsWith(href));
const current = nav
  .map((item) => item.href)
  .filter(matches)
  .sort((a, b) => b.length - a.length)[0];

const isCurrent = (href: string) => href === current;
---

<header
  class="sticky top-0 z-50 border-b border-line bg-paper/85 backdrop-blur-sm supports-[backdrop-filter]:bg-paper/70"
>
  <div class="mx-auto flex h-16 max-w-wide items-center gap-4 px-5 sm:gap-6 sm:px-8">
    <a
      href="/"
      class="font-display text-sm font-semibold tracking-tight whitespace-nowrap sm:text-[0.9375rem]"
      aria-label={`${site.name} — home`}
    >
      {site.name}
    </a>

    {
      /* No hamburger. A menu would mean JavaScript, a focus trap and an
        aria-expanded state to solve a problem six short links do not have.
        Below ~400px the list scrolls horizontally instead, with a fade on the
        right edge so the overflow reads as scrollable rather than clipped. */
    }
    <nav aria-label="Primary" class="primary-nav min-w-0 flex-1">
      <ul
        class="flex items-center gap-3.5 overflow-x-auto text-sm sm:gap-6 sm:text-[0.9375rem]"
      >
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class:list={[
                  'whitespace-nowrap transition-colors hover:text-accent',
                  isCurrent(item.href)
                    ? 'text-ink font-medium'
                    : item.emphasis
                      ? 'text-accent font-medium'
                      : 'text-muted',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      /* Contact is in `nav` above, carrying the one `emphasis` flag. A second
        link to it used to sit here, muted, and appeared from 640px up — the
        exact widths where the nav already shows it. That put the same label
        and the same href in one landmark twice, with only the nav copy marked
        `aria-current` on /contact/, and hid the spare at the one width where
        a second entry point would have been worth having. */
    }
    <ThemeToggle />
  </div>
</header>

<style>
  /* Hide the scrollbar without disabling scrolling — the fade below is the
     affordance, and a visible bar inside a 16px-tall header is worse. */
  .primary-nav ul {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .primary-nav ul::-webkit-scrollbar {
    display: none;
  }

  /* Only where the list can actually overflow. Above this width all four items
     fit and a fade would be a permanent smudge over the last one. */
  @media (max-width: 639px) {
    .primary-nav {
      mask-image: linear-gradient(to right, #000 calc(100% - 1.75rem), transparent);
    }

    .primary-nav ul {
      padding-right: 1.75rem;
    }
  }
</style>
