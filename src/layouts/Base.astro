---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { absolute, site } from '../data/site.ts';

interface Props {
  title: string;
  description: string;
  /** Omit the site name suffix — used on the home page, which sets its own. */
  bareTitle?: boolean;
  /** `article` for case studies and notes, `website` elsewhere. */
  ogType?: 'website' | 'article';
  /** Extra JSON-LD, merged into the graph the layout already emits. */
  schema?: Record<string, unknown>[];
  /** Suppresses indexing and the canonical link. Used by the 404 page, which
      has no canonical URL of its own — it is served for arbitrary paths. */
  noindex?: boolean;
  /**
   * Set by a page whose last section is full-bleed `bg-band` — a closing call
   * to action, typically.
   *
   * The footer is itself a band, and opens with `mt-24` so it is not welded to
   * body copy sitting on paper. On a page that already ends on a band, that
   * margin renders as a 6rem stripe of paper between two identical bands: a
   * seam that reads as a mistake rather than as breathing room. Flush, the two
   * bands meet and the footer's top border is the only division — which is the
   * intended reading, the page closing into its footer.
   *
   * `tests/layout.spec.ts` asserts this holds for every route, so a new page
   * that ends on a band and forgets the prop fails CI rather than shipping the
   * stripe.
   */
  flushFooter?: boolean;
}

const {
  title,
  description,
  bareTitle = false,
  ogType = 'website',
  schema = [],
  noindex = false,
  flushFooter = false,
} = Astro.props;

const pageTitle = bareTitle ? title : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.origin).href;

// Social images are pre-rendered by scripts/og.mjs and named after the path
// they belong to: /work/agendaprofe/ → work-agendaprofe.png. Deriving the name
// here means a new page picks up its image by adding one entry to that script,
// with no per-page wiring.
const ogSlug = Astro.url.pathname.replace(/^\/|\/$/g, '').replace(/\//g, '-') || 'default';
const ogImage = absolute(`/og/${ogSlug}.png`);

// One @graph rather than several disconnected blocks, so the Person node can be
// referenced by @id from every page-level node instead of being repeated.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.origin}/#person`,
      name: site.name,
      jobTitle: site.role,
      email: `mailto:${site.email}`,
      url: site.origin,
      sameAs: [site.github, site.linkedin],
      address: {
        '@type': 'PostalAddress',
        addressLocality: site.locality,
        addressRegion: site.region,
        addressCountry: site.country,
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${site.origin}/#website`,
      url: site.origin,
      name: `${site.name} — ${site.role}`,
      description: site.description,
      publisher: { '@id': `${site.origin}/#person` },
      inLanguage: 'en-GB',
    },
    ...schema,
  ],
};
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {
      /* The image is typographic — the title on a plain ground — so the page
        title is an accurate description of it, not a repetition. */
    }
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:locale" content="en_GB" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <meta name="author" content={site.name} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} — Notes`}
      href="/rss.xml"
    />

    {/* Both values so the browser chrome matches whichever theme renders. */}
    <meta name="theme-color" content="#f7f5ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1013" media="(prefers-color-scheme: dark)" />

    {
      /* Fonts are same-origin and render-blocking for LCP text, so they are
        preloaded. Only the two used above the fold — the mono face is used for
        small labels and can arrive late without shifting layout. */
    }
    <link
      rel="preload"
      href="/fonts/fraunces-latin-wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {
      /* Applies the stored theme before first paint. Inline and synchronous on
        purpose: as an external or deferred script this would run after the
        first frame and every dark-mode visitor would see a white flash. */
    }
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'dark' || stored === 'light') {
            document.documentElement.dataset.theme = stored;
          }
        } catch {
          /* Private mode, or storage disabled. The CSS media query still
             handles system preference, so there is nothing to recover from. */
        }
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer flush={flushFooter} />

    <Analytics />
  </body>
</html>
