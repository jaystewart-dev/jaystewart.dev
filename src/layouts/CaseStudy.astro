---
import Base from './Base.astro';
import MetricGrid from '../components/MetricGrid.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { absolute, site } from '../data/site.ts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'caseStudies'>;
  /** Headings extracted by MDX, used for the contents list. */
  headings: { depth: number; slug: string; text: string }[];
}

const { entry, headings } = Astro.props;
const { data } = entry;

const sections = headings.filter((h) => h.depth === 2);

const statusTone: Record<string, string> = {
  'In production': 'border-accent text-accent',
  'Parked, pre-launch': 'border-line-strong text-ink',
  Released: 'border-line-strong text-ink',
  Archived: 'border-line text-muted',
};

const schema = [
  {
    '@type': 'TechArticle',
    '@id': `${absolute(`/work/${entry.id}/`)}#article`,
    headline: data.title,
    description: data.description,
    author: { '@id': `${site.origin}/#person` },
    about: data.stack.join(', '),
    inLanguage: 'en-GB',
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absolute('/') },
      { '@type': 'ListItem', position: 2, name: 'Work', item: absolute('/work/') },
      { '@type': 'ListItem', position: 3, name: data.title },
    ],
  },
];
---

<Base
  title={data.title}
  description={data.description}
  ogType="article"
  schema={schema}
  flushFooter
>
  <article>
    <header class="border-b border-line bg-band">
      <div class="mx-auto max-w-content px-5 py-16 sm:px-8 sm:py-20">
        <nav aria-label="Breadcrumb" class="mb-6">
          <a href="/work/" class="eyebrow transition-colors hover:text-accent">← Work</a>
        </nav>

        <div class="flex flex-wrap items-center gap-3">
          <span
            class:list={[
              'rounded-full border px-2.5 py-0.5 font-mono text-xs',
              statusTone[data.status] ?? 'border-line text-muted',
            ]}
          >
            {data.status}
          </span>
          <span class="font-mono text-xs text-muted">{data.period}</span>
          <span class="text-xs text-line-strong" aria-hidden="true">·</span>
          <span class="font-mono text-xs text-muted">{data.role}</span>
        </div>

        <h1 class="mt-5 text-4xl sm:text-5xl">{data.title}</h1>
        <p class="mt-4 text-lg text-muted">{data.summary}</p>

        {
          data.anonymised && (
            // Better to state this plainly than to let a reader wonder why a
            // case study never names its subject.
            <p class="mt-6 rounded-md border-l-2 border-accent bg-surface py-3 pr-4 pl-4 text-sm text-muted">
              This company has not announced itself yet, so it is described without naming the
              product, the operator or the city. The engineering is unchanged.
            </p>
          )
        }

        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Technologies">
          {data.stack.map((item) => <li class="tag">{item}</li>)}
        </ul>

        {
          (data.url || data.repo) && (
            <div class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm">
              {data.url && (
                <a href={data.url} rel="noopener" class="link-underline text-accent">
                  Visit the product ↗
                </a>
              )}
              {data.repo && (
                <a href={data.repo} rel="noopener" class="link-underline text-accent">
                  Source ↗
                </a>
              )}
            </div>
          )
        }

        {data.metrics.length > 0 && <MetricGrid metrics={data.metrics} class="mt-10" />}
      </div>
    </header>

    <div
      class:list={[
        'mx-auto px-5 py-14 sm:px-8',
        sections.length > 2 ? 'max-w-wide' : 'max-w-content',
      ]}
    >
      <div
        class:list={[
          sections.length > 2 &&
            'lg:grid lg:grid-cols-[minmax(0,45rem)_14rem] lg:justify-center lg:gap-x-12',
        ]}
      >
        <div class="mx-auto w-full max-w-content lg:mx-0 lg:max-w-none">
          {sections.length > 2 && <TableOfContents sections={sections} variant="mobile" />}

          <div class="prose">
            <slot />
          </div>
        </div>

        {sections.length > 2 && <TableOfContents sections={sections} variant="desktop" />}
      </div>
    </div>

    <aside class="border-t border-line bg-band">
      <div class="mx-auto max-w-content px-5 py-14 sm:px-8">
        <h2 class="font-display text-2xl">Want the parts that are not written down?</h2>
        <p class="mt-3 text-muted">
          Most of this code is private. I am happy to walk through any of it — the schema, the
          failure modes, the things that went wrong first.
        </p>
        <a href="/contact/" class="btn btn-primary mt-6">Get in touch</a>
      </div>
    </aside>
  </article>
</Base>
