---
import Base from '../layouts/Base.astro';
import { site, contractMailto, conversationMailto } from '../data/site.ts';

/**
 * The secondary ask below links out as "production systems built almost
 * entirely with coding agents", not "where agents write most of the code".
 *
 * That second phrasing was the site's old leading positioning. It was demoted
 * out of the meta description on 2026-08-25 for the reason site.ts records —
 * to a hiring manager or a contract recruiter it reads as "he cannot code" —
 * and then survived here as link text on the page the CV's header line sends
 * that exact reader to. It is also an authorship claim, and the metric behind
 * it supports participation rather than authorship share
 * (hq, record/reviews/2026-08-20-authorship-attribution-audit.md).
 *
 * The counted claim on the home page stays exactly as it is: "more than 8 in
 * 10 commits ... written or co-written by an agent, counted from git history"
 * is that audit's own prescribed wording, and it travels with its definition.
 *
 * The Location line below reads "{site.location} — UK-based and available
 * now. ..." rather than "UK-based in {site.location} and available now. ...".
 * The interpolation used to sit inside the canonical availability sentence,
 * which made this page a variant of it: delivery-co/contracting.md requires
 * that sentence verbatim on every written surface. Moving the location ahead
 * of it keeps the fact and leaves the sentence contiguous, so the
 * text_matches_across assertion in delivery-co/.groundtruth.jsonc can check
 * this file at all — that kind normalizes whitespace and Markdown, never
 * template interpolation.
 */
---

<Base
  title="Contact"
  description={`Get in touch with Jay Stewart — UK-based and available for a three-to-six-month senior TypeScript and Next.js contract. ${site.email}`}
>
  <section class="mx-auto max-w-content px-5 py-16 sm:px-8 sm:py-24">
    <p class="eyebrow">Contact</p>
    <h1 class="mt-3 text-4xl sm:text-5xl">Let’s talk.</h1>

    <p class="mt-6 max-w-xl text-lg text-muted">
      <strong class="text-ink">I am available for contract work</strong> — three to six months, senior
      TypeScript, Next.js and Postgres, outside IR35 preferred. I contracted for four years before
      the break, on two concurrent engagements, one of which I built and then ran for the same client
      for four years. Ideally somewhere the hard problems are in the system rather than the interface,
      and where I would be reviewing other people’s code as well as writing my own.{' '}
      <a href={contractMailto} class="link-underline">Start that conversation</a>.
    </p>

    <p class="mt-5 max-w-xl text-lg text-muted">
      Separately: I run{' '}
      <a href="/work/agent-operated-codebase/" class="link-underline"
        >production systems built almost entirely with coding agents</a
      >, and I am still interested in what that actually changes inside real engineering teams —
      if yours builds with agents,{' '}
      <a href={conversationMailto} class="link-underline">twenty minutes comparing notes</a> is welcome
      whether or not there is a role behind it.
    </p>

    <dl class="mt-12 space-y-8">
      <div>
        <dt class="eyebrow">Email</dt>
        <dd class="mt-1.5 text-lg">
          <a href={`mailto:${site.email}`} class="link-underline">{site.email}</a>
        </dd>
      </div>
      <div>
        <dt class="eyebrow">LinkedIn</dt>
        <dd class="mt-1.5 text-lg">
          <a href={site.linkedin} rel="me noopener" class="link-underline">
            {site.linkedin.replace('https://www.', '')} ↗
          </a>
        </dd>
      </div>
      <div>
        <dt class="eyebrow">GitHub</dt>
        <dd class="mt-1.5 text-lg">
          <a href={site.github} rel="me noopener" class="link-underline">
            {site.githubHandle} ↗
          </a>
        </dd>
      </div>
      <div>
        <dt class="eyebrow">Location</dt>
        <dd class="mt-1.5 text-lg">
          {site.location} — UK-based and available now. Currently on a temporary working trip abroad,
          with a daily overlap from about 13:00 UK and flexibility outside it. Back in the UK early
          in the engagement, and on site from then.
        </dd>
      </div>
    </dl>

    <div class="mt-14 rounded-lg border border-line bg-band p-6 sm:p-8">
      <h2 class="text-xl">On the code you cannot see</h2>
      <p class="mt-3 text-muted">
        Most of the work described on this site is in private repositories. I am happy to walk
        through any of it in detail — schema, failure modes, the parts that went wrong first —
        or to share access where that is appropriate.
      </p>
    </div>
  </section>
</Base>
