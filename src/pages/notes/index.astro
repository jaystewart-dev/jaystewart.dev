---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="Notes"
  description="Short engineering write-ups: running a development environment as a server, designing around per-request cost, and checking agent-context files against the repository they describe."
>
  <section class="mx-auto max-w-content px-5 py-16 sm:px-8 sm:py-20">
    <p class="eyebrow">Notes</p>
    <h1 class="mt-3 text-4xl sm:text-5xl">Shorter pieces.</h1>
    <p class="mt-5 text-lg text-muted">
      Individual problems worth writing down — usually because the obvious solution was wrong,
      or because the failure mode was invisible.
    </p>

    <ul class="mt-14 divide-y divide-line border-y border-line">
      {
        notes.map((note) => (
          <li class="group relative py-7">
            <div class="flex flex-wrap items-center gap-2.5">
              <span class="font-mono text-xs text-muted">{note.data.topic}</span>
              <span class="text-muted" aria-hidden="true">
                ·
              </span>
              <time
                datetime={note.data.date.toISOString().slice(0, 10)}
                class="font-mono text-xs text-muted"
              >
                {note.data.date.toLocaleDateString('en-GB', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric',
                })}
              </time>
            </div>

            <h2 class="mt-2 text-xl">
              <a
                href={`/notes/${note.id}/`}
                class="after:absolute after:inset-0 after:content-[''] group-hover:text-accent"
              >
                {note.data.title}
              </a>
            </h2>

            <p class="mt-2 text-muted">{note.data.description}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
