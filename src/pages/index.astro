---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { site } from '../data/site.ts';
import { yearsOfExperience } from '../data/experience.ts';

const studies = (await getCollection('caseStudies', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const years = yearsOfExperience();
---

<Base title={`${site.name} — ${site.role}`} description={site.description} bareTitle>
  <section class="mx-auto max-w-wide px-5 pt-20 pb-16 sm:px-8 sm:pt-28 sm:pb-20">
    <p class="eyebrow">{site.role} · Remote · {site.location}</p>

    <h1 class="mt-5 max-w-3xl text-4xl leading-[1.1] sm:text-5xl lg:text-6xl">
      I build the systems that hold other people’s money and other people’s time.
    </h1>

    <div class="mt-8 max-w-2xl space-y-5 text-lg text-muted">
      <p>
        {years} years of backend engineering. The first decade was agency work on e-commerce platforms
        — high-traffic stores processing transactions and customer data, including Dyson’s. The kind
        of systems where an outage means lost orders rather than a failed build.
      </p>
      <p>
        Since 2020 I have been building products end to end: architecture, code, infrastructure,
        and the pager. Two of them are written up below — not as a portfolio list, but as the
        decisions, trade-offs and mistakes that actually made them.
      </p>
      <p>
        A large share of the recent commits were written with coding agents, inside verification
        gates built so the output can be trusted.
        <a href="/working-with-agents/" class="link-underline text-accent">How that works</a> is stated
        plainly rather than left to be inferred.
      </p>
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/work/" class="btn btn-primary">Read the case studies</a>
      <a href="/about/" class="btn btn-secondary">About me</a>
    </div>
  </section>

  <section aria-labelledby="work-heading" class="border-y border-line bg-band py-16 sm:py-20">
    <div class="mx-auto max-w-wide px-5 sm:px-8">
      <h2 id="work-heading" class="text-3xl">Selected work</h2>
      <p class="mt-3 max-w-2xl text-muted">
        The agent-operated practice this work runs on, and the two products it ships — one in
        production carrying real payments, one running and pre-launch. All described with their
        limitations intact.
      </p>

      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        {studies.map((entry) => <CaseStudyCard entry={entry} />)}
      </div>
    </div>
  </section>

  <section
    aria-labelledby="notes-heading"
    class="mx-auto max-w-wide px-5 py-16 sm:px-8 sm:py-20"
  >
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 id="notes-heading" class="text-3xl">Notes</h2>
        <p class="mt-3 max-w-xl text-muted">Shorter pieces on specific problems.</p>
      </div>
      <a href="/notes/" class="link-underline text-sm text-accent">All notes →</a>
    </div>

    <ul class="mt-10 divide-y divide-line border-y border-line">
      {
        notes.map((note) => (
          <li class="group relative flex flex-wrap items-baseline gap-x-4 gap-y-1 py-5">
            <span class="w-28 shrink-0 font-mono text-xs text-muted">{note.data.topic}</span>
            <h3 class="text-lg">
              <a
                href={`/notes/${note.id}/`}
                class="after:absolute after:inset-0 after:content-[''] group-hover:text-accent"
              >
                {note.data.title}
              </a>
            </h3>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="contact-heading" class="border-t border-line bg-band">
    <div class="mx-auto max-w-wide px-5 py-16 sm:px-8 sm:py-20">
      <h2 id="contact-heading" class="max-w-2xl text-3xl">
        Looking for a team where owning the whole stack is the job.
      </h2>
      <p class="mt-4 max-w-2xl text-muted">
        Backend, platform or founding engineering. I am most useful where the hard part is the
        system rather than the screen.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/contact/" class="btn btn-primary">Get in touch</a>
        <a href={`mailto:${site.email}`} class="btn btn-secondary">{site.email}</a>
      </div>
    </div>
  </section>
</Base>
