---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';

const studies = (await getCollection('caseStudies', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base
  title="Work"
  description="Engineering case studies: a production scheduling and payments platform, and a privacy-first system inferring live transit positions from anonymous signals."
>
  <section class="mx-auto max-w-wide px-5 py-16 sm:px-8 sm:py-20">
    <p class="eyebrow">Work</p>
    <h1 class="mt-3 max-w-2xl text-4xl sm:text-5xl">Two systems, written up properly.</h1>
    <p class="mt-5 max-w-2xl text-lg text-muted">
      Not a list of projects. Each of these explains the problem, the constraints that shaped
      the architecture, what the trade-offs actually cost, and where it currently falls short.
    </p>

    <div class="mt-14 grid gap-6 lg:grid-cols-2">
      {studies.map((entry) => <CaseStudyCard entry={entry} />)}
    </div>
  </section>
</Base>
