{
  "printWidth": 96,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "plugins": ["prettier-plugin-astro"],
  "overrides": [
    { "files": "*.astro", "options": { "parser": "astro" } },
    { "files": "*.md", "options": { "printWidth": 80, "proseWrap": "preserve" } },
    { "files": "*.mdx", "options": { "printWidth": 80, "proseWrap": "preserve" } }
  ]
}
